# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must never be committed.
# Every value below is a placeholder.

# Database
TJ_DATABASE_PATH=./data/tradejournal.db

# Hyperliquid (read-only, public info endpoint:
# Your public master account address, 42-character hex
# Do NOT use an agent / API wallet address: the info endpoint returns
# empty results for agent addresses.
TJ_HYPERLIQUID_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
TJ_HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info

# Variational Omni (file import) 
TJ_VARIATIONAL_IMPORT_DIR=./data/variational
TJ_VARIATIONAL_STATS_URL=https://omni-client-api.prod.ap-northeast-1.variational.io/metadata/stats

# HTTP behaviour (safe read requests only)
TJ_HTTP_TIMEOUT_SECONDS=10
TJ_HTTP_MAX_RETRIES=3

# Logging
TJ_LOG_LEVEL=INFO

# Optional live integration tests
# Disabled by default. Set to 1 only when you intentionally want
# read-only live API tests to run.
TJ_ENABLE_LIVE_TESTS=0